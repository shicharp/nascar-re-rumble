+			if (now > nextVbl + timestep)
 			{
+				nextVbl += timestep;
+				if (now - nextVbl > timestep * 8)
+					nextVbl = now;	// thread stalled for long: don't burst vblanks to catch up
+
 				SDL_LockMutex(g_intrMutex);
 				
 				if (vsync_callback)
@@ -182,8 +190,6 @@ int intrThreadMain(void* data)
 				
